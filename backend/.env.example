# Application Settings
APP_NAME="Bootcamp AI Backend"
APP_VERSION="0.1.0"
DEBUG=true
FRONTEND_URL="http://localhost:5173"

# File Upload Settings
UPLOAD_DIRECTORY="uploads"
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_EXTENSIONS=["pdf", "docx", "txt"]

# PostgreSQL / AsyncPG Database Connection
# NOT: Eğer veritabanı şifrende özel karakter (!, @, # vs.) varsa URL-encode etmen gerekebilir.
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sprintmate_db"

# Redis & Celery Settings
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Kişi 2 - AI & LLM Settings
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o"
LLM_API_KEY="your-api-key-here"  # Buraya gerçek OpenAI API anahtarını eklemeyi unutma
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Kişi 2 - Embedding Settings
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
EMBEDDING_DIMENSION=384